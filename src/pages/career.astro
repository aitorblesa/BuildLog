---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rule from '../components/ui/Rule.astro';
import SpecLabel from '../components/ui/SpecLabel.astro';
import CornerFrame from '../components/ui/CornerFrame.astro';
import MilestoneRow from '../components/features/roadmap/MilestoneRow.astro';
import { MILESTONES, PROJECTS } from '../data/roadmap';
---
<BaseLayout title="Career" active="career">
  <header class="mb-8">
    <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Frontend Career OS</p>
    <h1 class="mt-2 font-display text-3xl font-bold leading-[0.95] tracking-tight text-ink sm:text-4xl">ROAD TO 50K</h1>
    <p class="mt-1 font-mono text-xs text-muted">CAREER TRANSITION · NOT A GUARANTEE, A TARGET</p>
  </header>

  <Rule />

  <section class="py-6">
    <CornerFrame class="border border-rule px-4 py-5">
      <div class="flex items-center justify-between">
        <SpecLabel>Current</SpecLabel>
        <span class="font-mono text-[10px] text-muted">↓</span>
      </div>
      <p id="road-current-phase" class="mt-1 font-display text-lg font-bold text-ink">01 · MODERN FRONTEND FOUNDATION</p>

      <Rule class="my-4" />

      <SpecLabel>Current Focus</SpecLabel>
      <p id="road-current-focus" class="mt-1 font-display text-lg font-bold text-ink">REACT</p>

      <Rule class="my-4" />

      <SpecLabel>Next</SpecLabel>
      <p id="road-next-milestone" class="mt-1 font-display text-lg font-bold text-ink">M01 · REACT FOUNDATION</p>

      <Rule class="my-4" />

      <div class="grid grid-cols-2 gap-4">
        <div>
          <SpecLabel>Target</SpecLabel>
          <p class="mt-1 font-display text-2xl font-bold text-signal">40&ndash;50K</p>
        </div>
        <div>
          <SpecLabel>Time Horizon</SpecLabel>
          <p class="mt-1 font-display text-2xl font-bold text-ink">24M</p>
        </div>
      </div>
    </CornerFrame>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Main Gaps</SpecLabel>
    <ul id="road-gaps" class="mt-3 space-y-2">
      <li class="font-body text-sm text-muted">Calculating…</li>
    </ul>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Milestones</SpecLabel>
    <p class="mt-1 font-mono text-[10px] text-muted">TAP TO UPDATE STATUS · NOT DATE-BOUND</p>
    <div class="mt-2">
      {MILESTONES.map((milestone) => (
        <>
          <MilestoneRow milestone={milestone} />
          <Rule />
        </>
      ))}
    </div>
  </section>

  <section class="py-6">
    <SpecLabel>Portfolio</SpecLabel>
    <div class="mt-2 space-y-4">
      {PROJECTS.map((project) => (
        <div class="border border-rule px-4 py-4">
          <div class="flex items-baseline justify-between">
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">{project.code}</span>
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">{project.status}</span>
          </div>
          <p class="mt-2 font-display text-lg font-bold text-ink">{project.title}</p>
          <p class="mt-1 font-mono text-xs text-muted">{project.type}</p>
          <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.12em] text-muted">
            {project.competencies.join(' · ')}
          </p>
        </div>
      ))}
    </div>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Learning vs Career Capital</SpecLabel>
    <div class="mt-3 grid grid-cols-2 gap-4">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Learning</p>
        <p class="mt-2 font-body text-sm text-ink">Learn useReducer.</p>
        <p class="mt-1 font-body text-sm text-ink">Read the Server Components docs.</p>
      </div>
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-signal">Career Capital</p>
        <p class="mt-2 font-body text-sm text-ink">Apply it in a well-designed project.</p>
        <p class="mt-1 font-body text-sm text-ink">Add tests. Document it. Ship it.</p>
      </div>
    </div>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Frontend Career Coach</SpecLabel>
    <p class="mt-1 font-mono text-[10px] text-muted">LOCAL · OFFLINE STUB — READY FOR AI INTEGRATION</p>

    <div id="coach-transcript" class="mt-4 max-h-64 space-y-4 overflow-y-auto border border-rule px-4 py-4"></div>

    <div id="coach-suggestions" class="mt-3 flex flex-wrap gap-2"></div>

    <form id="coach-form" class="mt-3 flex gap-2">
      <input
        id="coach-input"
        type="text"
        aria-label="Ask the career coach"
        placeholder="Ask the coach…"
        class="min-w-0 flex-1 border border-rule bg-paper px-3 py-3 font-body text-sm text-ink outline-none focus-visible:border-ink"
      />
      <button
        type="submit"
        class="shrink-0 border border-ink bg-ink px-4 py-3 font-mono text-xs uppercase tracking-[0.14em] text-paper transition-colors duration-150 active:bg-signal active:border-signal"
      >
        Ask
      </button>
    </form>
  </section>

  <Rule />

  <footer class="py-6">
    <a href="/settings" class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted transition-colors duration-150 hover:text-ink">
      Settings →
    </a>
  </footer>

  <script src="../lib/client/hydrate-roadmap.ts"></script>
  <script src="../lib/client/hydrate-career.ts"></script>
</BaseLayout>
