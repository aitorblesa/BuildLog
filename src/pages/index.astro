---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rule from '../components/ui/Rule.astro';
import SpecLabel from '../components/ui/SpecLabel.astro';
import CornerFrame from '../components/ui/CornerFrame.astro';
import PrimaryAction from '../components/ui/PrimaryAction.astro';
import MeasurementRule from '../components/ui/MeasurementRule.astro';
import { PHASES, TASKS, getSkillLabel } from '../data/roadmap';

const totalPhases = PHASES.length;
// Marcador previo a la hidratación: la primera tarea de la ruta.
const firstTask = TASKS[0];
---
<BaseLayout title="Hoy" active="today">
  <header class="mb-8">
    <p class="font-mono text-[12px] uppercase tracking-[0.14em] text-muted">Carrera Frontend</p>
    <h1 class="mt-2 font-display text-3xl font-bold leading-[0.95] tracking-tight text-ink sm:text-4xl">
      CAMINO A 40&ndash;50K
    </h1>
    <p class="mt-1 font-mono text-xs text-muted">
      FASE <span id="current-phase-number">01</span> / {String(totalPhases).padStart(2, '0')}
    </p>
  </header>

  <Rule />

  <section class="py-6">
    <SpecLabel>Foco Actual</SpecLabel>
    <div class="mt-2 flex items-baseline justify-between">
      <p id="current-focus" class="font-display text-2xl font-bold text-ink">{getSkillLabel(firstTask.skillId).toUpperCase()}</p>
      <p id="current-focus-state" class="font-mono text-[12px] uppercase tracking-[0.14em] text-signal-ink">SIN EMPEZAR</p>
    </div>
    <p id="current-phase-name" class="mt-1 font-mono text-xs text-muted">FUNDAMENTOS DE FRONTEND MODERNO</p>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Hoy</SpecLabel>
    <CornerFrame class="mt-3 border border-rule px-4 py-5">
      <p id="task-number" class="font-mono text-[12px] uppercase tracking-[0.14em] text-muted">TAREA {String(firstTask.number).padStart(3, '0')}</p>
      <h2 id="task-title" class="mt-2 font-display text-xl font-bold leading-tight text-ink sm:text-2xl">
        {firstTask.title.toUpperCase()}
      </h2>
      <div class="mt-3 flex items-center justify-between">
        <p class="font-mono text-xs text-muted">EST. <span id="task-est">{firstTask.estMinutes} MIN</span></p>
      </div>
      <MeasurementRule class="mt-4" ticks={10} label="SESIÓN DE 25 MIN" />
      <PrimaryAction id="start-session-link" href="/session" class="mt-5">
        Empezar Sesión
      </PrimaryAction>
      <a
        id="review-task-link"
        href="/repaso"
        class="mt-3 inline-flex min-h-[52px] w-full items-center justify-center border border-rule-strong px-6 py-4 font-mono text-xs uppercase tracking-[0.16em] text-ink transition-colors duration-150 active:bg-rule"
      >
        Repasar Conceptos
      </a>
    </CornerFrame>
  </section>

  <Rule />

  <section id="work-first-block" class="py-6" hidden>
    <SpecLabel>Primero Trabajar / Luego Jugar</SpecLabel>
    <div id="work-first-pending" class="mt-2">
      <p class="font-mono text-xs text-muted">ANTES DEL TFT — COMPLETA LA SESIÓN DE 25 MIN DE HOY.</p>
    </div>
    <div id="work-first-done" class="mt-2" hidden>
      <p class="font-mono text-xs text-signal-ink">HECHO POR HOY — JUEGA SIN CULPA.</p>
    </div>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Esta Semana</SpecLabel>
    <div class="mt-3 grid grid-cols-3 gap-4">
      <div>
        <p id="week-focus" class="font-display text-xl font-bold text-ink">00:00</p>
        <p class="mt-1 font-mono text-[12px] uppercase tracking-[0.14em] text-muted">Foco</p>
      </div>
      <div>
        <p id="week-sessions" class="font-display text-xl font-bold text-ink">00</p>
        <p class="mt-1 font-mono text-[12px] uppercase tracking-[0.14em] text-muted">Sesiones</p>
      </div>
      <div>
        <p id="week-minimum-days" class="font-display text-xl font-bold text-ink">0 / 7</p>
        <p class="mt-1 font-mono text-[12px] uppercase tracking-[0.14em] text-muted">Días Mín.</p>
      </div>
    </div>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Siguiente</SpecLabel>
    <p id="next-target" class="mt-2 font-display text-lg font-bold text-ink">{getSkillLabel(TASKS[1].skillId).toUpperCase()}</p>
  </section>

  <script src="../lib/client/hydrate-today.ts"></script>
</BaseLayout>
