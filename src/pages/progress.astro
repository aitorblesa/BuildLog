---
import BaseLayout from '../layouts/BaseLayout.astro';
import Rule from '../components/ui/Rule.astro';
import SpecLabel from '../components/ui/SpecLabel.astro';
import { PHASES, getRootSkillsForPhase, getChildSkills } from '../data/roadmap';
---
<BaseLayout title="Progreso" active="progress">
  <header class="mb-8">
    <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">SO de Carrera Frontend</p>
    <h1 class="mt-2 font-display text-3xl font-bold leading-[0.95] tracking-tight text-ink sm:text-4xl">PROGRESO</h1>
    <p class="mt-1 font-mono text-xs text-muted">ESTADO DE SKILLS · REGISTRO DIARIO · REVISIÓN SEMANAL</p>
  </header>

  <Rule />

  <section class="py-6">
    <SpecLabel>Esta Semana</SpecLabel>
    <div class="mt-3 grid grid-cols-3 gap-4">
      <div>
        <p id="review-sessions" class="font-display text-xl font-bold text-ink">00</p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Sesiones</p>
      </div>
      <div>
        <p id="review-focus" class="font-display text-xl font-bold text-ink">00:00</p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Foco</p>
      </div>
      <div>
        <p id="review-completed" class="font-display text-xl font-bold text-ink">00</p>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Días Mín.</p>
      </div>
    </div>
  </section>

  <Rule />

  <section class="py-6">
    <div class="mt-3">
      {PHASES.map((phase) => (
        <div class="mb-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">{String(phase.number).padStart(2, '0')} · {phase.name}</p>
          {getRootSkillsForPhase(phase.id).map((root) => (
            <>
              <button type="button" class="skill-row flex min-h-11 w-full items-center justify-between gap-4 py-3 text-left" data-skill-id={root.id}>
                <span class="font-display text-sm font-bold uppercase tracking-tight text-ink">{root.name}</span>
                <span class="skill-state-label font-mono text-[10px] uppercase tracking-[0.14em] text-muted">SIN EMPEZAR</span>
              </button>
              <Rule />
              {getChildSkills(root.id).map((child) => (
                <>
                  <button type="button" class="skill-row flex min-h-11 w-full items-center justify-between gap-4 border-l border-rule py-3 pl-4 text-left" data-skill-id={child.id}>
                    <span class="font-body text-sm text-muted">{child.name}</span>
                    <span class="skill-state-label font-mono text-[10px] uppercase tracking-[0.14em] text-muted">SIN EMPEZAR</span>
                  </button>
                  <Rule />
                </>
              ))}
            </>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="py-6">
    <SpecLabel>Registro Diario</SpecLabel>
    <p id="daily-log-empty" class="mt-3 font-body text-sm text-muted">Aún no hay sesiones registradas. Empieza hoy.</p>
    <ul id="daily-log-list" class="mt-2 divide-y divide-rule"></ul>
  </section>

  <Rule />

  <section class="py-6">
    <SpecLabel>Revisión Semanal</SpecLabel>
    <form id="weekly-review-form" class="mt-3 space-y-4">
      <label class="block">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">¿Qué ha ido bien?</span>
        <textarea name="wentWell" rows={2} class="mt-2 w-full resize-none border border-rule-strong bg-paper px-3 py-3 font-body text-sm text-ink outline-none focus-visible:border-ink"></textarea>
      </label>
      <label class="block">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">¿Qué te ha bloqueado?</span>
        <textarea name="blocked" rows={2} class="mt-2 w-full resize-none border border-rule-strong bg-paper px-3 py-3 font-body text-sm text-ink outline-none focus-visible:border-ink"></textarea>
      </label>
      <label class="block">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">¿Cuál debería ser el foco la semana que viene?</span>
        <textarea name="nextFocus" rows={2} class="mt-2 w-full resize-none border border-rule-strong bg-paper px-3 py-3 font-body text-sm text-ink outline-none focus-visible:border-ink"></textarea>
      </label>
      <button type="submit" class="w-full border border-ink bg-ink px-6 py-4 font-mono text-xs uppercase tracking-[0.16em] text-paper transition-colors duration-150 active:bg-signal-ink active:border-signal-ink min-h-[52px]">
        Guardar Revisión
      </button>
      <p id="review-saved-status" role="status" class="text-center font-mono text-[10px] uppercase tracking-[0.14em] text-signal-ink" hidden>Guardado</p>
    </form>
  </section>

  <script src="../lib/client/hydrate-progress.ts"></script>
</BaseLayout>
