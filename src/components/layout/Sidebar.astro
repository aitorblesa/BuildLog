---
interface Props {
  active: 'today' | 'roadmap' | 'progress' | 'career';
}
const { active } = Astro.props;

const items = [
  { id: 'today', label: 'Hoy', href: '/' },
  { id: 'progress', label: 'Progreso', href: '/progress' },
  { id: 'roadmap', label: 'Ruta', href: '/roadmap' },
  { id: 'career', label: 'Carrera', href: '/career' },
] as const;
---
<aside
  class="sticky top-14 hidden h-[calc(100dvh-3.5rem)] w-56 shrink-0 lg:flex lg:items-center"
>
  <span
    class="absolute inset-y-12.5 right-0 w-px bg-linear-to-b from-transparent via-rule to-transparent"
    aria-hidden="true"
  ></span>
  <nav class="flex w-full flex-col gap-1 px-6" aria-label="Principal">
    {items.map((item) => (
      <a
        href={item.href}
        aria-current={active === item.id ? 'page' : undefined}
        class:list={[
          'flex min-h-11 items-center gap-2 py-2 font-mono text-xs uppercase tracking-[0.14em] transition-colors duration-150',
          active === item.id ? 'text-signal-ink' : 'text-muted hover:text-ink',
        ]}
      >
        <span
          class:list={['h-1 w-1 shrink-0', active === item.id ? 'bg-signal' : 'bg-transparent']}
          aria-hidden="true"
        ></span>
        {item.label}
      </a>
    ))}
  </nav>
</aside>
