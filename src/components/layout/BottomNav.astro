---
interface Props {
  active: 'today' | 'roadmap' | 'progress' | 'career';
}
const { active } = Astro.props;

const items = [
  { id: 'today', label: 'TODAY', href: '/' },
  { id: 'progress', label: 'PROGRESS', href: '/progress' },
  { id: 'roadmap', label: 'ROADMAP', href: '/roadmap' },
  { id: 'career', label: 'CAREER', href: '/career' },
] as const;
---
<nav
  class="safe-bottom fixed inset-x-0 bottom-0 z-40 border-t border-rule bg-paper backdrop-blur-none"
  aria-label="Primary"
>
  <ul class="mx-auto flex max-w-360">
    {items.map((item) => (
      <li class="flex-1">
        <a
          href={item.href}
          aria-current={active === item.id ? 'page' : undefined}
          class:list={[
            'flex flex-col items-center justify-center gap-1 py-3 font-mono text-[10px] uppercase tracking-[0.14em] transition-colors duration-150',
            active === item.id ? 'text-signal' : 'text-muted',
          ]}
        >
          <span
            class:list={['h-1 w-1', active === item.id ? 'bg-signal' : 'bg-transparent']}
            aria-hidden="true"
          ></span>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
