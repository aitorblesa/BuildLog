---
import { MILESTONE_STATUS_LABELS } from '../../../types';
import type { Milestone } from '../../../types';

interface Props {
  milestone: Milestone;
}
const { milestone } = Astro.props;
---
<button
  type="button"
  class="milestone-row flex min-h-11 w-full items-center justify-between gap-4 py-3 text-left transition-colors duration-150"
  data-milestone-id={milestone.id}
  data-status={milestone.status}
>
  <span class="flex items-center gap-3">
    <span class="font-mono text-[12px] uppercase tracking-[0.14em] text-muted">{milestone.code}</span>
    <span class="font-body text-sm text-ink">{milestone.title}</span>
  </span>
  <span class="milestone-status font-mono text-[12px] uppercase tracking-[0.14em] text-muted">
    {MILESTONE_STATUS_LABELS[milestone.status]}
  </span>
</button>
