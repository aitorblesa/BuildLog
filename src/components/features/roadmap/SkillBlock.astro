---
import type { Skill } from '../../../types';
import { getChildSkills, getTasksForSkill } from '../../../data/roadmap';
import ResourceList from './ResourceList.astro';
import TaskItem from './TaskItem.astro';

interface Props {
  skill: Skill;
  /** 0 = título (React), 1 = lección (Hooks). */
  level?: number;
}
const { skill, level = 0 } = Astro.props;
const children = getChildSkills(skill.id);
const tasks = getTasksForSkill(skill.id);
const isRoot = level === 0;
---
<div>
  <div
    class:list={[
      'flex items-baseline justify-between gap-4',
      isRoot ? 'border-b border-rule-strong pb-2' : '',
    ]}
  >
    {isRoot ? (
      <h3 class="font-display text-base font-bold uppercase tracking-tight text-ink">{skill.name}</h3>
    ) : (
      <h4 class="font-mono text-xs uppercase tracking-[0.14em] text-ink">{skill.name}</h4>
    )}
    <span
      data-skill-state
      data-skill-id={skill.id}
      class="shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-muted"
    >
      SIN EMPEZAR
    </span>
  </div>

  {skill.summary && (
    <p class="measure mt-2 font-body text-sm leading-relaxed text-muted">{skill.summary}</p>
  )}

  <ResourceList resources={skill.resources} class="mt-2" />

  {tasks.length > 0 && (
    <div class="mt-3">
      {tasks.map((task) => <TaskItem task={task} />)}
    </div>
  )}

  {children.length > 0 && (
    <div class="mt-4 space-y-5 border-l border-rule pl-4">
      {children.map((child) => <Astro.self skill={child} level={level + 1} />)}
    </div>
  )}
</div>
